SECRET_KEY=replace-with-a-secure-secret-key
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Set USE_SQLITE=True to run locally without PostgreSQL/Supabase
USE_SQLITE=False

# PostgreSQL / Supabase (Session pooler) settings
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=your-database-password
DB_HOST=localhost
DB_PORT=5432
DB_SSLMODE=prefer
